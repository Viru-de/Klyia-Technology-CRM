# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# HOSTINGER MYSQL DATABASE CONFIGURATION
# (Obtain these from Hostinger hPanel -> Databases -> MySQL Databases)
# ==============================================================================
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_klyia_db"
DB_USER="u123456789_klyia_user"
DB_PASSWORD="your_strong_mysql_password_here"

# Server configuration
PORT="3000"
NODE_ENV="production"

